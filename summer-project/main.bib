@article{zhong_morphbungee-tiny_2025,
	title = {{MorphBungee}-{Tiny}: {An} {Ultra}-{Low}-{Cost} {FPGA} {Implementation} of {Neuromorphic} {Architecture} {With} {High}-{Accuracy} {On}-{Chip} {E}-{Prop} {Learning}},
