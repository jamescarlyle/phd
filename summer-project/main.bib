	keywords = {neuromorphic computing, on-chip learning, Synapses, System-on-chip, Neuromorphics, Neurons, Power demand, spiking neural network (SNN), Timing, spiking neural network, Application-specified integrated circuit (ASIC), asynchronous circuits, Logic gates, analog},
	pages = {2717--2729},
	file = {Full Text PDF:/Users/jamescarlyle/Zotero/storage/Y5L82BMP/Zhang et al. - 2024 - ANP-I A 28-nm 1.5-pJSOP Asynchronous Spiking Neural Network Processor Enabling Sub-0.1-μ JSample.pdf:application/pdf},
