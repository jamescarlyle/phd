	file = {PDF:/Users/jamescarlyle/Zotero/storage/CJCV7QM3/Bellec et al. - 2020 - A solution to the learning dilemma for recurrent networks of spiking neurons.pdf:application/pdf},
}

@misc{shen_tim_2024,
	title = {{TIM}: {An} {Efficient} {Temporal} {Interaction} {Module} for {Spiking} {Transformer}},
