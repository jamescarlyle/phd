@article{zhong_morphbungee-lite_2025,
	title = {{MorphBungee}-{Lite}: {An} {Edge} {Neuromorphic} {Architecture} {With} {Balanced} {Cross}-{Core} {Workloads} {Based} on {Layer}-{Wise} {Event}-{Batch} {Learning}/{Inference}},
