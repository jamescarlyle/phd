	keywords = {6G smart city, data-driven optimization, digital twin, Edge AI, electric mobility, Energy, federated edge AI, Federated learning, inhardware learning., low-power ASIC, Modeling, Neuromorphic computing, Neuromorphics, Optimization, Printing, Reduced instruction set computing, RISC-V SoC, spiking neural networks, System-on-chip, Timing},
