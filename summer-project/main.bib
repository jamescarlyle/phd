	keywords = {Hafnium compounds, MNIST recognition system, neuromorphic systems, Neuromorphics, Neurons, nonvolatile memory, Pattern recognition, Performance evaluation, Reliability, resistive RAM (RRAM) arrays, RRAM reliability soft errors, Training},
	pages = {3125--3137},
	file = {Full Text PDF:/Users/jamescarlyle/Zotero/storage/KJ8Y9R7M/Tosson et al. - 2017 - A Study of the Effect of RRAM Reliability Soft Errors on the Performance of RRAM-Based Neuromorphic.pdf:application/pdf},
