@article{basu_low-power_2018,
	title = {Low-{Power}, {Adaptive} {Neuromorphic} {Systems}: {Recent} {Progress} and {Future} {Directions}},
	volume = {8},
	issn = {2156-3365},
	shorttitle = {Low-{Power}, {Adaptive} {Neuromorphic} {Systems}},
