	keywords = {Bio-inspired Algorithms, Bioinformatics, Biology, edge hardware, Genomics, Hardware, Neuromorphic Computing, Neuromorphic engineering, Parallel processing, Power demand, power optimization, Reinforcement learning, Reinforcement Learning, Spiking neural networks, Spiking Neural Networks, System-on-chip},
	pages = {1--6},
	file = {Full Text PDF:/Users/jamescarlyle/Zotero/storage/LJVSJR98/Roosan et al. - 2026 - Bio-Inspired Reinforcement Learning to Optimize Power Consumption on Neuromorphic Edge Hardware for.pdf:application/pdf},
