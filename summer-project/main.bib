@article{bianchi_compact_2020,
	title = {A {Compact} {Model} for {Stochastic} {Spike}-{Timing}-{Dependent} {Plasticity} ({STDP}) {Based} on {Resistive} {Switching} {Memory} ({RRAM}) {Synapses}},
