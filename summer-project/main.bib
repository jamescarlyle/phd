	pages = {1--6},
	file = {Full Text PDF:/Users/jamescarlyle/Zotero/storage/6S8RIWUZ/Kim et al. - 2019 - An Energy-efficient On-chip Learning Architecture for STDP based Sparse Coding.pdf:application/pdf},
}

