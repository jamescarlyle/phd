@article{chen_visual-cortex-mimetic_2025,
	title = {A {Visual}-{Cortex}-{Mimetic} {Tiny} {Neuromorphic} {Vision} {Processor} {Based} on {Reconfigurable} {Cortical} {Neuron} {Unit}},
