	keywords = {1T1R, 2-D-FET, 3-D-integration, Computer architecture, graphene, h-BN, in-memory computing, memristor, Microprocessors, neural circuit, neuromorphic computing, Neuromorphics, Optical pulse generation, Performance evaluation, plasticity, RRAM, Smart devices, smart transistor, Switches, switching-energy, switching-speed, synapse, transition metal di-chalcogenide, van der Waals (vdW) materials, WS₂},
	pages = {2033--2040},
