}

@article{cheng_anp-r_2026,
	title = {{ANP}-{R}: {A} 22nm 0.{88pJ}/{SOP} {Asynchronous} {SNN}-based {Processor} with {Coarse}-{Grained} {Reconfigurable} {Architecture} {Enabling} {Multisensory} {On}-chip {Incremental} {Learning} for {Edge} {AI}},
	issn = {1940-9990},
	shorttitle = {{ANP}-{R}},
	url = {https://ieeexplore.ieee.org/document/11585946/},
	doi = {10.1109/TBCAS.2026.3708212},
	abstract = {Spiking Neural Networks (SNNs) have emerged as a promising paradigm for brain-inspired edge computing. Leveraging binary spikes and local learning rules, SNNs enable energy-efficient on-chip learning and rapid adaptation to changing environments, which is crucial for edge AI that needs to learn continuously from new data. However, many SNN processors enabling on-chip learning for edge computing confront a trade-off: small-scale task-specific designs offer low power but poor multi-task inference accuracy, while large-scale general-purpose designs achieve high multi-task accuracy at the cost of large memory and poor energy efficiency. To overcome this challenge, this paper presents ANP-R, a 22nm asynchronous SNN-based edge AI processor with coarse-grained reconfigurable architecture enabling one-shot, few-shot, batch and incremental on-chip learning. The processor integrates 64 cores containing 4096 neurons and 0.262 million synapses. Two key features are proposed: 1) An asynchronous coarse-grained reconfigurable architecture that supports various STDP-based SNN topologies. These topologies enable over 95\% average accuracy across four sensory tasks; 2) an energy-efficient asynchronous training method incorporating a self-adaptive synaptic weight update mechanism reducing up to 65\% redundant updates without accuracy loss, and a trained weights low-bit width coding method reducing up to 50\% storage cost with 0.3\% accuracy loss. Measurement results demonstrate 92.1\% accuracy for hand gesture classification, 93.9\% for keyword spotting, 98.6\% for object recognition and 99.2\% for gas identification. Compared with state-of-the-art SNN-based chips, this work achieves up to 6.02x, 8.61x and 7.1\% improvement in energy efficiency, energy per step, and accuracy, respectively.},
	urldate = {2026-08-14},
	journal = {IEEE Transactions on Biomedical Circuits and Systems},
	author = {Cheng, Ziyi and Huo, Dexuan and Zhang, Jilin and Wang, Zhihua and Chen, Hong},
	year = {2026},
	keywords = {Accuracy, asynchronous circuit, coarse-grained reconfigurable architecture, Gases, Learning (artificial intelligence), Modeling, Neurons, on-chip incremental learning, Program processors, SNN, STDP, System-on-chip, Timing, Topology, Training},
	pages = {1--11},
	file = {Full Text PDF:/Users/jamescarlyle/Zotero/storage/BHIFRUZT/Cheng et al. - 2026 - ANP-R A 22nm 0.88pJSOP Asynchronous SNN-based Processor with Coarse-Grained Reconfigurable Archite.pdf:application/pdf},
}

@inproceedings{roosan_bio-inspired_2026,
	title = {Bio-{Inspired} {Reinforcement} {Learning} to {Optimize} {Power} {Consumption} on {Neuromorphic} {Edge} {Hardware} for {Multi}-{Omics} and {Molecular} {Data} {Simulation}},
	issn = {2158-8481},
	url = {https://ieeexplore.ieee.org/document/11418873/},
	doi = {10.1109/MELECON64486.2026.11418873},
	abstract = {Bio-inspired reinforcement learning (RL) algorithms implemented on neuromorphic hardware offer a promising avenue for tackling problems in genomics and molecular simulation. Neuromorphic computing systems can execute spiking neural networks with high parallelism and energy efficiency, making them well-suited for genomic data processing and molecular dynamics. Our objective was to present a study that integrates RL algorithms with spiking neural network implementations on neuromorphic chips to accelerate genomic data analysis and molecular conformational sampling. We design a spiking RL architecture featuring on-chip learning rules inspired by synaptic plasticity, and we evaluate its performance on tasks: genomic sequence analysis and protein folding simulation. The system achieves comparable accuracy to state-of-the-art deep learning baselines on these tasks while dramatically reducing power consumption and latency. This work illustrates the potential of combining brain-inspired algorithms and hardware to advance computational biology, and it paves the way for intelligent, low-power devices for genomic analysis and molecular discovery. However, the present study has several limitations. All experiments are performed in Loihi emulation mode on relatively small benchmark tasks, and the molecular case study uses a simplified folding scenario rather than full production-scale simulations, so additional work is needed to validate the framework on physical hardware and larger, noisier biological datasets.},
	urldate = {2026-08-14},
	booktitle = {2026 {IEEE} 23rd {Mediterranean} {Electrotechnical} {Conference} ({MELECON})},
	author = {Roosan, Don and Hai, Fahmida and Nirzhor, Saif and Khan, Rubayat},
	month = feb,
