	author = {Nazari, Najmeh and Gubbi, Kevin Immanuel and Latibari, Banafsheh Saber and Chowdhury, Muhtasim Alam and Fang, Chongzhou and Sasan, Avesta and Rafatirad, Setareh and Homayoun, Houman and Salehi, Soheil},
	month = may,
	year = {2024},
	note = {ISSN: 2158-1525},
	keywords = {AI Accelerator, analog, Computer architecture, Cross-Layer Security, Hardware, Machine learning, Machine Learning Hardware, Noise, On-Chip Learning, Privacy, Side-channel attacks, spiking neural network, Spiking Neural Networks, Training},
	pages = {1--5},
	file = {Full Text PDF:/Users/jamescarlyle/Zotero/storage/U8R36W3C/Nazari et al. - 2024 - Securing On-Chip Learning Navigating Vulnerabilities and Potential Safeguards in Spiking Neural Net.pdf:application/pdf},
