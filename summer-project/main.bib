	keywords = {Frequency measurement, Hebbian learning, memristor, Memristors, nano-crystalline silicon, neuromorphic, Neurons, Noise measurement, Silicon, SPICE, thin-film transistor, Transistors},
	pages = {565--573},
	file = {Full Text PDF:/Users/jamescarlyle/Zotero/storage/NQ4HJD5Z/Cantley et al. - 2012 - Neural Learning Circuits Utilizing Nano-Crystalline Silicon Transistors and Memristors.pdf:application/pdf},
