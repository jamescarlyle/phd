@inproceedings{zhang_226_2023,
	title = {22.6 {ANP}-{I}: {A} 28nm 1.{5pJ}/{SOP} {Asynchronous} {Spiking} {Neural} {Network} {Processor} {Enabling} {Sub}-{O}.1 μ{J}/{Sample} {On}-{Chip} {Learning} for {Edge}-{AI} {Applications}},
