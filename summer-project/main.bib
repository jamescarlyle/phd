	keywords = {Encoding, Hardware, Homeostasis, in situ, memristive SNN (MSNN), Memristors, neuromorphic system, Neuromorphics, Neurons, nonideal effect, spiking-timing-dependent plasticity (STDP), Synapses, temporal order encoding, Training},
	pages = {448--461},
	file = {Full Text PDF:/Users/jamescarlyle/Zotero/storage/A9BHYNEK/Li et al. - 2022 - In Situ Learning in Hardware Compatible Multilayer Memristive Spiking Neural Network.pdf:application/pdf},
}

@inproceedings{huo_28nm_2023,
