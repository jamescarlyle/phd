	pages = {89--97},
	file = {Full Text PDF:/Users/jamescarlyle/Zotero/storage/ADHVAXCH/Pedretti et al. - 2020 - A Spiking Recurrent Neural Network With Phase-Change Memory Neurons and Synapses for the Accelerated.pdf:application/pdf},
