	title = {Quantum-{Inspired} {RISC}-{Based} {Neuromorphic} {SoC} {Architecture} for {Federated} {Edge} {AI} with {DataDriven} {Low}-{Power} {Digital} {ASIC} {Optimization} in {6G}-{Enabled} {Smart}-{City} {Electric} {Mobility} {Digital} {Twin} {Ecosystems}},
	url = {https://ieeexplore.ieee.org/document/11582559/},
	doi = {10.1109/ADSSSC67751.2026.11582559},
	abstract = {This paper presents a silicon-validated 7 nm RISC- V-based neuromorphic System-on-Chip (SoC) designed for energy-efficient federated edge artificial intelligence (AI) in 6G-enabled smart mobility and digital twin applications. The proposed architecture integrates a programmable RV64 core with an event-driven spiking neural network (SNN) accelerator and on-chip learning support. A key contribution is a quantum-inspired scheduling and mapping framework that optimizes neuron placement and communication patterns, significantly reducing interconnect overhead and improving execution efficiency. The prototype SoC comprises 16 neuromorphic processing elements supporting up to {\textbackslash}mathbf1 6 K neurons with distributed synaptic memory. Post-silicon measurements demonstrate an average power consumption of 50 mW during inference, achieving 0.48 {\textbackslash}mu {\textbackslash}mathrm J energy per inference and sub- {\textbackslash}mathbf1. 2 m s latency. Compared to state-of-the-art edge AI accelerators, the proposed system delivers up to 12 {\textbackslash}times improvement in energy efficiency under equivalent workload conditions while maintaining competitive accuracy (92.7\% on benchmark SNN tasks). The architecture further supports on- chip federated learning with gradient compression, reducing communication overhead by 89\% and enabling scalable edge deployment. A hardware-in-the-loop digital twin framework is implemented for electric mobility scenarios, demonstrating real-time adaptive optimization and improved system-level efficiency. The results establish the viability of combining neuromorphic computing, federated learning, and quantum- inspired optimization in a unified silicon platform, offering a scalable and energy-efficient solution for next-generation edge intelligence systems.},
	urldate = {2026-08-14},
	booktitle = {2026 {International} {Conference} on {AI}-{Driven} {Solutions} for {Sustainable} {Smart} {Cities}: {Challenges} and {Opportunities} ({ADSSSC})},
